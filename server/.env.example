# ============================================================
#  Slice House — server configuration
#  Copy this file to server/.env (npm install does it for you)
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional. Leave empty to start an in-memory MongoDB for the demo.
# For a real database use e.g. mongodb://127.0.0.1:27017/slicehouse
# or a MongoDB Atlas connection string.
MONGO_URI=

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Seeded admin account (separate from the customer login)
ADMIN_NAME=Slice House Admin
ADMIN_EMAIL=admin@slicehouse.test
ADMIN_PASSWORD=Admin@12345

# ---- Razorpay (test mode) ----
# Get these from https://dashboard.razorpay.com → Settings → API keys
# Leave empty to use the built-in demo checkout instead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Email / SMTP ----
# Leave empty in development: emails are written to server/dev-outbox/
# and the verification / reset links are printed in the terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Slice House <no-reply@slicehouse.test>

# ---- Inventory alerts ----
LOW_STOCK_THRESHOLD=20
LOW_STOCK_CRON=*/5 * * * *
LOW_STOCK_ALERT_HOURS=24

# ---- Pricing ----
CURRENCY=INR
DELIVERY_FEE=49
FREE_DELIVERY_OVER=799
TAX_PERCENT=5
